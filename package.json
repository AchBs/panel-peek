{
  "name": "panel-peek",
  "version": "1.0.0",
  "description": "Panel Peek: a transparent, always-on-top manga/manhwa reader that hides as a bubble when you're not hovering it.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.5.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.panelpeek",
    "productName": "Panel Peek",
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "portable": {
      "artifactName": "PanelPeek-${version}.exe"
    }
  },
  "productName": "Panel Peek"
}
